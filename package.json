  "dependencies": {
    "commander": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh20raj/sanskrit.git"
  },
  "bugs": {
