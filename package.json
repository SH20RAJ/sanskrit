{
  "name": "sanskrit-lang",
  "version": "0.2.0",
  "description": "A modern programming language combining Sanskrit vocabulary and Devanagari script with contemporary programming constructs",
  "main": "src/index.js",
  "bin": {
    "sanskrit": "bin/sanskrit"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node bin/sanskrit repl",
    "check": "node bin/sanskrit check",
    "pack:test": "npm pack --dry-run"
  },
  "keywords": [
    "sanskrit",
    "programming-language",
    "devanagari",
    "interpreter",
    "compiler",
    "ast",
    "lexer",
    "parser",
    "javascript"
  ],
  "author": "Shaswat Raj",
