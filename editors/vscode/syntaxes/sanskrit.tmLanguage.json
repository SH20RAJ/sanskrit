{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sanskrit Next",
  "scopeName": "source.sanskrit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#function-declarations" },
    { "include": "#type-annotations" },
    { "include": "#builtins" },
    { "include": "#function-calls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.sanskrit",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.sanskrit",
          "match": "#.*$"
        },
        {
          "name": "comment.block.sanskrit",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sanskrit",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sanskrit",
              "match": "\\\\(?:[nrt\\\\\"'0]|u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2})"
            }
          ]
        },
        {
          "name": "string.quoted.single.sanskrit",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sanskrit",
              "match": "\\\\(?:[nrt\\\\\"'0]|u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2})"
            }
          ]
        }
      ]
    },
    "function-declarations": {
      "patterns": [
        {
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(कार्य|fn)\\s+([a-zA-Z_\\u0900-\\u097F][a-zA-Z0-9_\\u0900-\\u097F]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.sanskrit" },
            "2": { "name": "entity.name.function.declaration.sanskrit" }
          }
        }
      ]
    },
    "type-annotations": {
      "patterns": [
        {
          "match": "(:)\\s*([a-zA-Z_\\u0900-\\u097F][a-zA-Z0-9_\\u0900-\\u097F]*(?:\\[[^\\]]+\\])?)",
          "captures": {
            "1": { "name": "punctuation.separator.colon.sanskrit" },
            "2": { "name": "entity.name.type.sanskrit" }
          }
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(मुद्रण|विफल|निश्चय|अवकलन|प्रवणता|print|println|diff|grad|zeros|ones|randn|eye|matmul|transpose|reshape|sum|mean|assert|panic)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "([a-zA-Z_\\u0900-\\u097F][a-zA-Z0-9_\\u0900-\\u097F]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.sanskrit" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(यदि|अन्यथा|if|else|match|case)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "keyword.control.loop.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(यावत्|प्रत्येक|while|for|in|break|continue)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "keyword.control.flow.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(प्रत्यागम|return)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "keyword.declaration.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(कार्य|मान|स्थिर|प्रकार|गुण|प्रयोजयतु|fn|let|const|mut|struct|trait|impl|type|enum)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "keyword.control.import.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(आयात|निर्यातः|संकुल|import|export|mod|use|as|from|pub|extern)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "keyword.control.async.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(अतुल्यकालिक|प्रतीक्षते|async|await|spawn|channel)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "variable.language.self.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(आत्मा|self|Self)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(पूर्णाङ्क|दशमलव|तर्क|अक्षर|सूत्र|शून्यम्|संख्या|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|str|void)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "entity.name.type.tensor.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(दिश|Tensor|Dual|Grad|Tape|Matrix|Vector)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(सत्यम्|असत्यम्|true|false)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "constant.language.null.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])(शून्यम्|null|nil|None|Some)(?![a-zA-Z0-9_\\u0900-\\u097F])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.devanagari.sanskrit",
          "match": "(?<![a-zA-Z0-9_\\u0900-\\u097F])[०-९]+(?:\\.[०-९]+)?(?![a-zA-Z0-9_\\u0900-\\u097F])"
        },
        {
          "name": "constant.numeric.hex.sanskrit",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.sanskrit",
          "match": "\\b0b[01]+\\b"
        },
        {
          "name": "constant.numeric.float.sanskrit",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.sanskrit",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tensor.matmul.sanskrit",
          "match": "@"
        },
        {
          "name": "keyword.operator.comparison.sanskrit",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.sanskrit",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.sanskrit",
          "match": "\\+=|-=|\\*=|/=|="
        },
        {
          "name": "keyword.operator.arithmetic.sanskrit",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.arrow.sanskrit",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.namespace.sanskrit",
          "match": "::"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.colon.sanskrit",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.sanskrit",
          "match": ","
        },
        {
          "name": "punctuation.terminator.semicolon.sanskrit",
          "match": ";"
        },
        {
          "name": "punctuation.bracket.round.sanskrit",
          "match": "[()]"
        },
        {
          "name": "punctuation.bracket.square.sanskrit",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.bracket.curly.sanskrit",
          "match": "[{}]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sanskrit",
          "match": "[a-zA-Z_\\u0900-\\u097F][a-zA-Z0-9_\\u0900-\\u097F]*"
        }
      ]
    }
  }
}
