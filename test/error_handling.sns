// संस्कृत भाषा - त्रुटि प्रबंधन
// Error Handling Example

कार्य भाग_करें(क, ख) {
    यदि (ख === ०) {
        फेंक "शून्य से भाग नहीं किया जा सकता";
    }
    प्रत्यागम क / ख;
}

कार्य सुरक्षित_गणना() {
    प्रयत्न {
        चर परिणाम१ = भाग_करें(१०, २);
        मुद्रण("१० ÷ २ =", परिणाम१);
        
        चर परिणाम२ = भाग_करें(१०, ०);
        मुद्रण("यह नहीं छपेगा");
    } पकड़ (त्रुटि) {
        मुद्रण("त्रुटि पकड़ी गई:", त्रुटि);
    } अंततः {
        मुद्रण("सफाई का काम पूरा");
    }
}

सुरक्षित_गणना();

// Another example
कार्य सरणी_पहुंच(सरणी, सूचकांक) {
    प्रयत्न {
        यदि (सूचकांक < ० || सूचकांक >= लंबाई(सरणी)) {
            फेंक "अवैध सूचकांक";
        }
        प्रत्यागम सरणी[सूचकांक];
    } पकड़ (त्रुटि) {
        मुद्रण("सरणी पहुंच त्रुटि:", त्रुटि);
        प्रत्यागम शून्य;
    }
}

चर संख्याएं = [१, २, ३, ४, ५];
मुद्रण("वैध पहुंच:", सरणी_पहुंच(संख्याएं, २));
मुद्रण("अवैध पहुंच:", सरणी_पहुंच(संख्याएं, १०));