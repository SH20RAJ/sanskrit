// संस्कृत भाषा - उन्नत सुविधाएं
// Advanced Features Demo

// Variables and Constants
चर नाम = "राम";
स्थिर पाई = ३.१४१५९;
चर आयु = २५;

मुद्रण("नाम:", नाम);
मुद्रण("आयु:", आयु);
मुद्रण("पाई:", पाई);

// Arrays and Objects
चर संख्याएं = [१, २, ३, ४, ५];
चर व्यक्ति = {
    नाम: "सीता",
    आयु: २२,
    शहर: "अयोध्या"
};

मुद्रण("संख्याएं:", संख्याएं);
मुद्रण("व्यक्ति:", व्यक्ति);
मुद्रण("पहली संख्या:", संख्याएं[०]);
मुद्रण("व्यक्ति का नाम:", व्यक्ति.नाम);

// Control Flow - If/Else
यदि (आयु >= २१) {
    मुद्रण("वयस्क है");
} अन्यथा {
    मुद्रण("नाबालिग है");
}

// Loops
मुद्रण("गिनती:");
पुनः (चर i = १; i <= ५; i++) {
    मुद्रण("संख्या:", i);
}

// While loop
चर गिनती = ०;
यावत् (गिनती < ३) {
    मुद्रण("गिनती:", गिनती);
    गिनती++;
}

// Functions with return values
कार्य वर्ग(संख्या) {
    प्रत्यागम संख्या * संख्या;
}

कार्य जोड़(क, ख) {
    प्रत्यागम क + ख;
}

मुद्रण("५ का वर्ग:", वर्ग(५));
मुद्रण("१० + २० =", जोड़(१०, २०));

// Advanced Math Operations
मुद्रण("२ की शक्ति ८:", २ ** ८);
मुद्रण("१७ % ५ =", १७ % ५);

// Logical Operations
चर सत्य_मान = सत्य;
चर असत्य_मान = असत्य;

मुद्रण("सत्य और असत्य:", सत्य_मान && असत्य_मान);
मुद्रण("सत्य या असत्य:", सत्य_मान || असत्य_मान);
मुद्रण("सत्य नहीं:", !सत्य_मान);

// String operations
चर अभिवादन = "नमस्ते";
चर संसार = "संसार";
मुद्रण(अभिवादन + " " + संसार + "!");

// Comparison operators
मुद्रण("५ > ३:", ५ > ३);
मुद्रण("२ === २:", २ === २);
मुद्रण("'राम' !== 'सीता':", "राम" !== "सीता");

// Assignment operators
चर x = १०;
x += ५;
मुद्रण("x += ५:", x);
x *= २;
मुद्रण("x *= २:", x);

// Built-in functions
मुद्रण("संख्याएं की लंबाई:", लंबाई(संख्याएं));
मुद्रण("नाम का प्रकार:", प्रकार(नाम));
मुद्रण("आयु का प्रकार:", प्रकार(आयु));

// Complex expressions
चर परिणाम = (१० + ५) * २ - ३;
मुद्रण("जटिल गणना:", परिणाम);

मुद्रण("सभी परीक्षण पूर्ण!");