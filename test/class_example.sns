// संस्कृत भाषा - वर्ग उदाहरण
// Class Example

वर्ग व्यक्ति {
    निर्माण(नाम, आयु) {
        स्व.नाम = नाम;
        स्व.आयु = आयु;
    }
    
    कार्य परिचय() {
        मुद्रण("नमस्ते, मेरा नाम", स्व.नाम, "है और मैं", स्व.आयु, "वर्ष का हूं।");
    }
    
    कार्य जन्मदिन() {
        स्व.आयु++;
        मुद्रण("जन्मदिन मुबारक!", स्व.नाम, "अब", स्व.आयु, "वर्ष के हैं।");
    }
    
    स्थैतिक कार्य प्रजाति() {
        मुद्रण("मानव");
    }
}

वर्ग छात्र विस्तार व्यक्ति {
    निर्माण(नाम, आयु, कक्षा) {
        सुपर(नाम, आयु);
        स्व.कक्षा = कक्षा;
    }
    
    कार्य अध्ययन() {
        मुद्रण(स्व.नाम, "कक्षा", स्व.कक्षा, "में अध्ययन कर रहा है।");
    }
    
    कार्य परिचय() {
        मुद्रण("नमस्ते, मैं", स्व.नाम, "हूं,", स्व.आयु, "वर्ष का हूं और कक्षा", स्व.कक्षा, "में पढ़ता हूं।");
    }
}

// Usage
चर राम = नया व्यक्ति("राम", २५);
राम.परिचय();
राम.जन्मदिन();

चर अर्जुन = नया छात्र("अर्जुन", १६, "दसवीं");
अर्जुन.परिचय();
अर्जुन.अध्ययन();

व्यक्ति.प्रजाति();