// संस्कृत भाषा - एल्गोरिदम उदाहरण
// Algorithm Examples

// Fibonacci Sequence
कार्य फिबोनाची(n) {
    यदि (n <= १) {
        प्रत्यागम n;
    }
    प्रत्यागम फिबोनाची(n - १) + फिबोनाची(n - २);
}

मुद्रण("फिबोनाची श्रृंखला:");
पुनः (चर i = ०; i <= १०; i++) {
    मुद्रण("F(" + i + ") =", फिबोनाची(i));
}

// Factorial
कार्य गुणनखंड(n) {
    यदि (n <= १) {
        प्रत्यागम १;
    }
    प्रत्यागम n * गुणनखंड(n - १);
}

मुद्रण("गुणनखंड:");
पुनः (चर i = १; i <= ५; i++) {
    मुद्रण(i + "! =", गुणनखंड(i));
}

// Prime Number Check
कार्य अभाज्य_है(n) {
    यदि (n <= १) {
        प्रत्यागम असत्य;
    }
    यदि (n <= ३) {
        प्रत्यागम सत्य;
    }
    यदि (n % २ === ० || n % ३ === ०) {
        प्रत्यागम असत्य;
    }
    
    चर i = ५;
    यावत् (i * i <= n) {
        यदि (n % i === ० || n % (i + २) === ०) {
            प्रत्यागम असत्य;
        }
        i += ६;
    }
    प्रत्यागम सत्य;
}

मुद्रण("अभाज्य संख्याएं (१ से २०):");
पुनः (चर i = १; i <= २०; i++) {
    यदि (अभाज्य_है(i)) {
        मुद्रण(i, "अभाज्य है");
    }
}

// Array sorting (Bubble Sort)
कार्य बुलबुला_क्रमबद्ध(सरणी) {
    चर n = लंबाई(सरणी);
    पुनः (चर i = ०; i < n - १; i++) {
        पुनः (चर j = ०; j < n - i - १; j++) {
            यदि (सरणी[j] > सरणी[j + १]) {
                // Swap elements
                चर temp = सरणी[j];
                सरणी[j] = सरणी[j + १];
                सरणी[j + १] = temp;
            }
        }
    }
    प्रत्यागम सरणी;
}

चर अक्रमित = [६४, ३४, २५, १२, २२, ११, ९०];
मुद्रण("मूल सरणी:", अक्रमित);
चर क्रमबद्ध = बुलबुला_क्रमबद्ध(अक्रमित);
मुद्रण("क्रमबद्ध सरणी:", क्रमबद्ध);

// Binary Search
कार्य द्विआधारी_खोज(सरणी, लक्ष्य) {
    चर बाएं = ०;
    चर दाएं = लंबाई(सरणी) - १;
    
    यावत् (बाएं <= दाएं) {
        चर मध्य = गणित_न्यूनतम((बाएं + दाएं) / २);
        
        यदि (सरणी[मध्य] === लक्ष्य) {
            प्रत्यागम मध्य;
        } अन्यथा यदि (सरणी[मध्य] < लक्ष्य) {
            बाएं = मध्य + १;
        } अन्यथा {
            दाएं = मध्य - १;
        }
    }
    
    प्रत्यागम -१;
}

चर खोजी_सरणी = [१, ३, ५, ७, ९, ११, १३, १५];
चर खोजा_गया = द्विआधारी_खोज(खोजी_सरणी, ७);
मुद्रण("७ का स्थान:", खोजा_गया);

// GCD (Greatest Common Divisor)
कार्य महत्तम_समापवर्तक(क, ख) {
    यावत् (ख !== ०) {
        चर temp = ख;
        ख = क % ख;
        क = temp;
    }
    प्रत्यागम क;
}

मुद्रण("GCD(४८, १८) =", महत्तम_समापवर्तक(४८, १८));